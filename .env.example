# Copy to .env and adjust for your environment.

# Live backend origin. The client appends /api unless the value already ends in /api.
VITE_BACKEND_URL=https://api.theswiftentry.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Realtime (Pusher / Laravel Echo)
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
VITE_PUSHER_FORCE_TLS=true
VITE_ECHO_HOST=http://127.0.0.1:8000
VITE_ECHO_PORT=6001

# --- Prototype switches ---
# true  = seeded multi-tenant demo through the in-browser axios adapter
# false = talk to the real Laravel API
VITE_USE_MOCK_API=false

# true  = single POST /auth/login contract
# false = legacy five-probe login (admin/staff/security/front-desk/self-service)
VITE_SINGLE_LOGIN=false

# Reserved for future demo scenarios.
VITE_MOCK_SCENARIO=normal
